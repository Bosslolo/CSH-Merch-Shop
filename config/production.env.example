# Copy to config/production.env and fill in real values.
# NEVER commit production.env to git.

# Shared CSH payment credentials (PayPal + Stripe + Hub)
# Preferred source on this machine:
#   E:\Schülerfirma\shared\csh-payments.env
# Loaded automatically by start scripts / server. Local keys below override shared ones.

# --- Merch-shop specific ---
ADMIN_PASSWORD=change-me-to-a-strong-password
PORT=5174

# Return URLs for Stripe Checkout (merch shop)
STRIPE_SUCCESS_BASE_URL=http://10.100.5.89:5174
STRIPE_CANCEL_BASE_URL=http://10.100.5.89:5174
STRIPE_CHECKOUT_COMPANY_NAME=CSH Merch
SHOP_PUBLIC_BASE_URL=http://10.100.5.89:5174

# Laurin IT Check hub (same HUB_API_KEY as kaffeeliste / hub server)
# HUB_API_KEY=preview-hub-key-local
# HUB_PUSH_ENABLED=true
# HUB_PUSH_INTERVAL_SECONDS=60
# HUB_PUSH_MODE=production
# HUB_PUSH_URL=https://hub.icicles.online/api/ingest/csh-merch
# Or local Mac hub while testing:
# HUB_PUSH_MODE=local
# HUB_PUSH_LOCAL_HOST=YOUR_MAC_LAN_IP
# HUB_PUSH_LOCAL_PORT=5180
