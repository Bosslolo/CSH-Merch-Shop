# Admin access (required for /verwaltung login)
ADMIN_PASSWORD=change-me-to-a-strong-password
# Dedicated session HMAC secret (recommended — do not reuse the password)
ADMIN_SESSION_SECRET=generate-a-long-random-hex-string

# Vote API (UI may say coming soon; server must also be off)
VOTING_ENABLED=false

# Only trust X-Forwarded-For when behind a real reverse proxy
TRUST_PROXY=0

# Auto-cancel unpaid pending orders after N minutes (stock restored)
ORDER_UNPAID_TTL_MINUTES=120

# Optional: Laurin Hub metrics bridge (same key as laurin-hub HUB_API_KEY)
HUB_API_KEY=generate-a-long-random-string

# Push metrics to the IT Check hub (outbound — works from any server/NAT).
# HUB_PUSH_URL=https://hub.icicles.online/api/ingest/csh-merch
# HUB_PUSH_ENABLED=true
# HUB_PUSH_INTERVAL_SECONDS=60

# Server port (default 5174)
# PORT=5174

# --- Payments (SAME keys as Kaffeeliste on school server) ---
# See docs/CURSOR-PAYMENTS-SCHOOL-SERVER.md — never commit real secrets
# PAYPAL_ME_HANDLE=
# PAYPAL_BUSINESS_EMAIL=
# PAYPAL_MANAGED_QR_ID=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SHOP_PUBLIC_BASE_URL=https://shop.example
# STRIPE_SUCCESS_BASE_URL=https://shop.example
# STRIPE_CANCEL_BASE_URL=https://shop.example
