# Admin access (required for /verwaltung login)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: Laurin Hub metrics bridge (same key as laurin-hub HUB_API_KEY)
HUB_API_KEY=generate-a-long-random-string

# Push metrics to the IT Check hub (outbound — works from any server/NAT).
# Comma-separated URLs allowed for multiple hubs.
# HUB_PUSH_URL=https://hub.icicles.online/api/ingest/csh-merch
# HUB_PUSH_ENABLED=true
# HUB_PUSH_INTERVAL_SECONDS=60

# Server port (default 5174)
# PORT=5174
